---
import { cn } from "@lib/utils";

type Props = {
  label?: string;
  class?: string;
};

const { label = "Razon Komar Pal", class: className } = Astro.props;
---

<span
  class={cn("group relative inline-flex select-none align-middle", className)}
  role="img"
  aria-label={label}
  title={label}
>
  <svg
    viewBox="0 0 64 64"
    class="size-7 rounded-full transition-transform duration-300 ease-out group-hover:scale-110"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="avatar-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFE1C7"></stop>
        <stop offset="100%" stop-color="#FBC9A0"></stop>
      </linearGradient>
    </defs>

    <circle
      cx="32"
      cy="32"
      r="31.5"
      fill="url(#avatar-bg)"
      class="stroke-black/10 dark:stroke-white/15"
      stroke-width="1"></circle>

    <g fill="#292524">
      <g class="transition-opacity duration-300 ease-out group-hover:opacity-0">
        <ellipse cx="24" cy="27" rx="3.4" ry="4.4"></ellipse>
        <ellipse cx="40" cy="27" rx="3.4" ry="4.4"></ellipse>
      </g>
      <g
        class="opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
        fill="none"
        stroke="#292524"
        stroke-width="3"
        stroke-linecap="round"
      >
        <path d="M20 28 Q24 23 28 28"></path>
        <path d="M36 28 Q40 23 44 28"></path>
      </g>
    </g>

    <g fill="none" stroke="#292524" stroke-width="3" stroke-linecap="round">
      <path
        class="transition-opacity duration-300 ease-out group-hover:opacity-0"
        d="M25 42 H39"></path>
      <path
        class="opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
        d="M23 39 Q32 51 41 39"></path>
    </g>

    <g class="opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-40" fill="#d97706">
      <circle cx="17" cy="37" r="4"></circle>
      <circle cx="47" cy="37" r="4"></circle>
    </g>
  </svg>
</span>
