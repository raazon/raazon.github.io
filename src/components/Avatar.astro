---
import { cn } from "@lib/utils";

type Props = {
  label?: string;
  class?: string;
};

const { label = "Razon Komar Pal", class: className } = Astro.props;
---

<span
  class={cn("group relative inline-flex select-none align-middle", className)}
  role="img"
  aria-label={label}
  title={label}
>
  <svg
    viewBox="0 0 128 128"
    class="size-7 rounded-full transition-transform duration-300 ease-out group-hover:scale-110"
    aria-hidden="true"
  >
    <defs>
      <clipPath id="avatar-portrait-clip">
        <circle cx="64" cy="64" r="63"></circle>
      </clipPath>
      <linearGradient id="avatar-bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f8eee4" class="dark:[stop-color:#292a2b]"></stop>
        <stop offset="100%" stop-color="#e9d8c7" class="dark:[stop-color:#171819]"></stop>
      </linearGradient>
      <linearGradient id="avatar-skin" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fbcf9f"></stop>
        <stop offset="60%" stop-color="#f0b17a"></stop>
        <stop offset="100%" stop-color="#e0a068"></stop>
      </linearGradient>
      <linearGradient id="avatar-neck" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#b8763a"></stop>
        <stop offset="45%" stop-color="#e59f62"></stop>
        <stop offset="100%" stop-color="#f0ac6f"></stop>
      </linearGradient>
      <radialGradient id="avatar-nose" cx="50%" cy="35%" r="70%">
        <stop offset="0%" stop-color="#f6c18f"></stop>
        <stop offset="100%" stop-color="#e29e68"></stop>
      </radialGradient>
      <linearGradient id="avatar-beard" x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0%" stop-color="#2c211a"></stop>
        <stop offset="60%" stop-color="#1c1613"></stop>
        <stop offset="100%" stop-color="#0f0d0b"></stop>
      </linearGradient>
      <linearGradient id="avatar-shirt" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#484847"></stop>
        <stop offset="50%" stop-color="#5d5d5c"></stop>
        <stop offset="100%" stop-color="#484847"></stop>
      </linearGradient>
      <linearGradient id="avatar-hair" x1="0" y1="0" x2="0.8" y2="1">
        <stop offset="0%" stop-color="#1c1714"></stop>
        <stop offset="100%" stop-color="#0a0908"></stop>
      </linearGradient>
      <radialGradient id="avatar-eye" cx="45%" cy="40%">
        <stop offset="0%" stop-color="#9a6427"></stop>
        <stop offset="65%" stop-color="#5a3313"></stop>
        <stop offset="100%" stop-color="#1c130c"></stop>
      </radialGradient>
    </defs>

    <circle
      cx="64"
      cy="64"
      r="63"
      fill="url(#avatar-bg)"
      class="stroke-black/10 dark:stroke-white/15"
      stroke-width="1"></circle>

    <g clip-path="url(#avatar-portrait-clip)">
      <g transform="translate(64 66) scale(0.96) translate(-64 -60)">
        <!-- arms -->
        <path d="M12 118 H31 V128 H12Z" fill="#d99a5f"></path>
        <path d="M96 118 H116 V128 H96Z" fill="#d99a5f"></path>

        <!-- shirt -->
        <path d="M44 78.7 L23 89 Q13 100 11.5 120 Q21 125 31 125 L31.5 128 H96 L96.5 125 Q106 125 116 120 Q114 100 105 89 L84 80 Q64 108 44 78.7Z" fill="url(#avatar-shirt)"></path>
        <path d="M23.7 89 Q29 105 31 125" fill="none" stroke="#3d3d3c" stroke-width=".8" opacity=".6"></path>
        <path d="M104.3 89 Q99 105 96.5 125" fill="none" stroke="#3d3d3c" stroke-width=".8" opacity=".6"></path>
        <path d="M44 78.7 Q64 108 84 80" fill="none" stroke="#454544" stroke-width=".9" opacity=".7"></path>

        <!-- neck -->
        <path d="M48.5 68 L47 79.5 Q64 98.6 81 81 L79.5 68Z" fill="url(#avatar-neck)"></path>
        <path d="M47 79.5 Q64 98.6 81 81" fill="none" stroke="#3f3f3e" stroke-width=".8" opacity=".55"></path>

        <!-- ears -->
        <path d="M39.5 44 Q33 41.5 34.3 50 Q35 58 39.8 60Z" fill="url(#avatar-skin)"></path>
        <path d="M88 44 Q94.5 41.5 93.2 50 Q92.5 58 88 60Z" fill="url(#avatar-skin)"></path>
        <path d="M37.2 46 Q35.8 50 37.2 56" fill="none" stroke="#d3915a" stroke-width=".8" stroke-linecap="round" opacity=".55"></path>
        <path d="M90.3 46 Q91.7 50 90.3 56" fill="none" stroke="#d3915a" stroke-width=".8" stroke-linecap="round" opacity=".55"></path>

        <!-- face -->
        <path d="M39 38 Q38 26 44 22 Q52 18.5 64 18.8 Q76 18.5 84 22 Q90 26 89 38 L88.5 55 Q88 72 64 81 Q40 72 39.5 55Z" fill="url(#avatar-skin)"></path>

        <!-- cheek blush -->
        <ellipse cx="45" cy="52" rx="7" ry="6" fill="#ee9f80" opacity=".28"></ellipse>
        <ellipse cx="83" cy="52" rx="7" ry="6" fill="#ee9f80" opacity=".28"></ellipse>

        <!-- hair -->
        <path d="M37.5 43 L36 27.5 Q36 18 44 12 Q52 6 62 5 Q74 4.5 82 10 Q88 14 88.6 19 L90.7 22.5 L90 37 L88 44 Q87 33 85.5 27 Q83 21 74 20 Q64 18.8 54 20.5 Q45 22 42.5 27 Q40 33 39.5 44Z" fill="url(#avatar-hair)"></path>
        <path d="M46 11 Q58 5.5 72 6.8 Q80 8 85 13" fill="none" stroke="#3a322b" stroke-width="1.6" stroke-linecap="round" opacity=".7"></path>
        <path d="M41 17 Q46 11 54 9" fill="none" stroke="#2e2822" stroke-width="1.2" stroke-linecap="round" opacity=".7"></path>
        <path d="M86.5 15 L88.6 18 L87.6 21" fill="none" stroke="#0a0908" stroke-width="1.4" stroke-linecap="round"></path>

        <!-- eyebrows -->
        <path d="M42.5 39.5 Q45 34.5 52 32.7 Q56 32.2 58.3 33.5 L58 36 Q52 35 47 37.3 Q44.5 38.5 43.3 40.8Z" fill="#241a14"></path>
        <path d="M69 34 Q72 32.4 76 32.8 Q83 34.5 85 39.5 L83.7 40.8 Q81.5 37.5 76 36 Q72 35.5 69 36.2Z" fill="#241a14"></path>

        <!-- eyes -->
        <g>
          <ellipse cx="52" cy="44" rx="6.2" ry="4" fill="#fffaf4"></ellipse>
          <ellipse cx="75" cy="44" rx="6.2" ry="4" fill="#fffaf4"></ellipse>
          <circle cx="52" cy="44" r="3.6" fill="url(#avatar-eye)"></circle>
          <circle cx="75" cy="44" r="3.6" fill="url(#avatar-eye)"></circle>
          <circle cx="52" cy="44" r="1.7" fill="#0b0605"></circle>
          <circle cx="75" cy="44" r="1.7" fill="#0b0605"></circle>
          <circle cx="51" cy="42.9" r="1.1" fill="#fff"></circle>
          <circle cx="74" cy="42.9" r="1.1" fill="#fff"></circle>
          <circle cx="53.3" cy="45.4" r=".45" fill="#fff" opacity=".7"></circle>
          <circle cx="76.3" cy="45.4" r=".45" fill="#fff" opacity=".7"></circle>
          <path d="M45.7 44.2 Q52 39.2 58.2 43.8" fill="none" stroke="#3a2418" stroke-width=".9" stroke-linecap="round"></path>
          <path d="M68.8 43.8 Q75 39.2 81.3 44.2" fill="none" stroke="#3a2418" stroke-width=".9" stroke-linecap="round"></path>
          <g class="avatar-eyelids" fill="#f0b783">
            <ellipse cx="52" cy="44" rx="6.8" ry="4.5"></ellipse>
            <ellipse cx="75" cy="44" rx="6.8" ry="4.5"></ellipse>
          </g>
        </g>

        <!-- nose -->
        <ellipse cx="63.5" cy="52.6" rx="6" ry="4.8" fill="url(#avatar-nose)"></ellipse>
        <path d="M58.5 55.5 Q63.5 58 68.5 55.5" fill="none" stroke="#cf8b55" stroke-width=".8" stroke-linecap="round" opacity=".5"></path>

        <!-- beard -->
        <path d="M38.8 46 Q38.3 58 41.5 64 Q46 73 55 78 Q60 80.8 64 80.8 Q68 80.8 73 78 Q82 73 86.5 64 Q89.7 58 89 46 Q88.3 56 84 58 Q78 57.3 70 57.3 Q64 57 58 57.3 Q50 57.3 44 58 Q40 56 38.8 46Z" fill="url(#avatar-beard)"></path>
        <path d="M48.5 60.5 Q50 57 56 57 Q64 56.2 72 57 Q78 57 79.5 60.5 Q76 61 72 61.4 Q64 60.4 56 61.4 Q51 61 48.5 60.5Z" fill="#120e0b"></path>
        <path d="M60 72 Q64 74 68 72 Q68 77 64 78 Q60 77 60 72Z" fill="#0d0b09" opacity=".8"></path>

        <!-- smile (rest) -->
        <g class="transition-opacity duration-300 ease-out group-hover:opacity-0">
          <path d="M51.5 61.2 Q64 63.6 76 61.2 Q74.5 69.2 64 69.6 Q53.5 69.2 51.5 61.2Z" fill="#dc9a78"></path>
          <path d="M53.6 62.1 Q64 64.1 74.4 62.1 L73.4 65.3 Q64 67 54.6 65.3Z" fill="#fffaf3"></path>
          <path d="M58.2 63.2 V66 M61.3 63.5 V66.4 M64 63.6 V66.5 M66.8 63.5 V66.4 M69.8 63.2 V66" fill="none" stroke="#e2d8cf" stroke-width=".5" opacity=".8"></path>
        </g>
        <!-- smile (hover) -->
        <g class="opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100">
          <path d="M50.5 60.5 Q64 64.5 77.5 60.5 Q76 72 64 72.5 Q52 72 50.5 60.5Z" fill="#4a1c14"></path>
          <path d="M52.5 61.6 Q64 65.4 75.5 61.6 L74.6 66 Q64 68.6 54.4 66Z" fill="#fffaf3"></path>
          <path d="M56 69.6 Q64 67.6 72 69.6 Q70 72.3 64 72.4 Q58 72.3 56 69.6Z" fill="#d97562"></path>
        </g>

        <!-- hover blush -->
        <g class="opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-40" fill="#d66d50">
          <ellipse cx="44" cy="55" rx="5" ry="2.5"></ellipse>
          <ellipse cx="84" cy="55" rx="5" ry="2.5"></ellipse>
        </g>
      </g>
    </g>

    <circle
      cx="64"
      cy="64"
      r="63"
      fill="none"
      class="stroke-black/10 dark:stroke-white/15"
      stroke-width="1"></circle>
  </svg>
</span>

<style>
  .avatar-eyelids {
    transform-box: fill-box;
    transform-origin: center;
    animation: avatar-blink 5s infinite;
  }

  @keyframes avatar-blink {
    0%, 92%, 100% { transform: scaleY(0); }
    93%, 95% { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-eyelids {
      animation: none;
    }
  }
</style>